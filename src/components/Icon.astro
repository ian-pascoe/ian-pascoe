---
import { ICONS, type IconName } from "../lib/icons";

interface Props {
  name: IconName;
}

const { name } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
>
  <path d={ICONS[name]}></path>
</svg>
