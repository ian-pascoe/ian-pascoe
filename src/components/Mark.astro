---
import { MARKS, type MarkName } from "../lib/marks";

interface Props {
  /** Renders nothing when absent, so callers can pass an optional mark straight through. */
  name?: MarkName;
  class?: string;
}

const { name, class: className } = Astro.props;
const mark = name && MARKS[name];
const [, , w, h] = mark ? mark.viewBox.split(" ") : [];
---

{
  mark && (
    <svg
      class:list={["mark", `mark--${mark.shape}`, className]}
      viewBox={mark.viewBox}
      style={`aspect-ratio: ${w} / ${h}`}
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <use href={`/marks.svg#${name}`} />
    </svg>
  )
}

<style>
  .mark {
    display: inline-block;
    flex: none;
    height: 1em;
    width: auto;
    overflow: visible;
  }
</style>
