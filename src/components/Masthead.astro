---
import Icon from "./Icon.astro";
import type { Profile } from "../lib/exhibition";
import type { Fall } from "../lib/fall";
import { OBSERVATIONS } from "../lib/observations";

interface Props {
  profile: Profile;
  fall: Fall;
}

const { profile, fall } = Astro.props;
const span = fall.now - fall.firstTime;
// Each year on the rail links to the first plate of that year, in reading order.
const years = fall.years.map(({ year }) => ({
  year,
  at: ((Date.UTC(year, 0, 1) - fall.firstTime) / span) * 100,
  first: fall.fragments.find((f) => new Date(f.work.key).getUTCFullYear() === year),
}));
---

<header class="masthead">
  <a class="masthead__name caps" href="#main">{profile.name}</a>
  <nav class="rail" aria-label="The record by year">
    <ol class="rail__years" role="list">
      {
        years.map(({ year, at, first }) => (
          <li style={`--at: ${at}%`}>
            {first ? (
              <a class="tabular" href={`#${first.id}`} data-rail-year={year}>
                {year}
              </a>
            ) : (
              <span class="tabular">{year}</span>
            )}
          </li>
        ))
      }
      <li class="rail__now" style="--at: 100%">Now</li>
    </ol>
    <span class="rail__marker" data-rail-marker aria-hidden="true"></span>
  </nav>
  <a class="masthead__log" href="#observations" data-log-indicator>
    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.5"></circle><circle cx="10" cy="10" r="2.2"></circle></svg>
    <span class="tabular"><span data-log-tally>0</span><span class="masthead__log-total">/{OBSERVATIONS.length}</span></span>
    <span class="masthead__log-word">observed</span>
    <span class="visually-hidden">: your observations</span>
  </a>
  <a class="button button--primary masthead__email" href={`mailto:${profile.email}`} data-observe="say-hello">
    <Icon name="orbit" />
    Email Ian
  </a>
  <p class="masthead__flash" data-log-flash aria-hidden="true"></p>
  <p class="visually-hidden" role="status" data-log-status></p>
</header>

<style>
  .masthead {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-6);
    height: var(--masthead);
    padding-inline: var(--gutter);
    background: var(--void-deep);
    border-bottom: 1px solid var(--rule);
  }

  .masthead__name {
    font-size: var(--step--1);
    font-weight: 450;
    letter-spacing: 0.24em;
    text-decoration: none;
    white-space: nowrap;
  }

  .rail {
    container-type: inline-size;
    position: relative;
    justify-self: center;
    width: min(100%, 34rem);
    height: 100%;
  }

  .rail__years {
    position: absolute;
    inset: 0 2.75rem 0 0.75rem;
  }

  /* The rail itself: one etched line from the first year to now. */
  .rail__years::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    border-top: 1px solid var(--rule-strong);
  }

  .rail__years li {
    position: absolute;
    left: var(--at);
    top: 50%;
    translate: -50% 0;
    font-size: 0.6875rem;
    font-stretch: 112%;
    letter-spacing: 0.08em;
    color: var(--bone-quiet);
  }

  .rail__years li::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -0.45rem;
    height: 0.45rem;
    border-left: 1px solid var(--rule-strong);
  }

  .rail__years a,
  .rail__years span {
    display: block;
    padding: 0.2rem 0.25rem;
    text-decoration: none;
  }

  .rail__years a:hover,
  .rail__years a[aria-current] {
    color: var(--gold);
  }

  /* "Now" hangs to the right of its tick, clear of the current year's label. */
  .rail__years .rail__now {
    translate: 0 0;
    padding: 0.2rem 0 0 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--gold);
  }

  .rail__marker {
    position: absolute;
    top: 50%;
    left: calc(0.75rem + var(--depth, 0) * (100% - 3.5rem));
    width: 0.5rem;
    height: 0.5rem;
    margin: -0.25rem 0 0 -0.25rem;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 3px var(--void-deep);
    opacity: 0;
    transition: opacity var(--fast) var(--ease);
  }

  .rail__marker.is-shown {
    opacity: 1;
  }

  .masthead__log {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    color: var(--bone-soft);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .masthead__log svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-dasharray: 2 2;
    transition: stroke var(--slow) var(--ease);
  }

  .masthead__log.has-logged svg {
    stroke: var(--gold);
    stroke-dasharray: none;
  }

  .rail__years .rail__now::before {
    left: 0;
  }

  /* When labels no longer fit (a narrow rail, or text enlarged), alternate years keep only their ticks. */
  @container (max-width: 30rem) {
    .rail__years li:nth-child(even):not(.rail__now) :is(a, span) {
      visibility: hidden;
    }
  }

  @container (max-width: 16rem) {
    .rail__years li:not(:first-child, .rail__now) :is(a, span) {
      visibility: hidden;
    }
  }

  .masthead__log-word {
    color: var(--bone-quiet);
  }

  .masthead__email {
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    font-size: 0.75rem;
  }

  /* A new observation hangs under the masthead for a moment, out of flow. */
  .masthead__flash {
    position: absolute;
    right: var(--gutter);
    top: calc(100% + var(--space-3));
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--gold);
    border-radius: 999px;
    background: var(--void-deep);
    color: var(--gold);
    font-size: var(--step--1);
    font-stretch: 112%;
    letter-spacing: 0.08em;
    opacity: 0;
    translate: 0 -0.35rem;
    pointer-events: none;
    transition:
      opacity var(--slow) var(--ease),
      translate var(--slow) var(--ease);
  }

  .masthead__flash:global(.is-shown) {
    opacity: 1;
    translate: 0 0;
  }

  @media (max-width: 52rem) {
    .masthead {
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: var(--space-3);
    }

    .rail {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .masthead__log-word,
    .masthead__log-total {
      display: none;
    }
  }

  @media (max-width: 24rem) {
    .masthead__name {
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      line-height: 1.25;
      white-space: normal;
    }

    .masthead__email {
      padding-inline: var(--space-3);
    }
  }
</style>
