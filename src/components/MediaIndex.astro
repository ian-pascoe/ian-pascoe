---
import { mediaIndex, type Exhibition } from "../lib/exhibition";
import { skillMark } from "../lib/marks";
import Mark from "./Mark.astro";

interface Props {
  exhibition: Exhibition;
}

const index = mediaIndex(Astro.props.exhibition);
---

<section class="media wrap" id="media" data-room-section="media" aria-labelledby="media-heading">
  <h2 id="media-heading" class="media__head">Index of media</h2>
  <ul class="media__list" role="list">
    {
      index.map(({ skill, works }) => {
        // Each medium points at the latest work that proves it; every label lists its own media.
        const latest = works.reduce((a, b) => (b.key > a.key ? b : a));
        return (
          <li>
            <a href={`#${latest.id}`} data-light-link={latest.id} aria-label={`${skill}, latest in ${latest.title}`}>
              <Mark name={skillMark(skill)} />
              {skill}
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .media {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-9);
  }

  .media__head {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
    font-size: var(--step-3);
    font-weight: 750;
    letter-spacing: -0.025em;
  }

  .media__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
  }

  .media__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-weight: 650;
    text-decoration: none;
  }

  .media__list a:hover {
    text-decoration: underline;
  }

  .media__list :global(.mark) {
    height: 1.25em;
  }
</style>
