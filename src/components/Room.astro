---
import { dayCount, roomRange, type Room } from "../lib/exhibition";
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import Work from "./Work.astro";

interface Props {
  room: Room;
}

const { room } = Astro.props;
const headingId = `room-${room.id}-heading`;
---

<section class:list={["room", { "room--compact": room.works.length <= 2 }]} id={`room-${room.id}`} data-paint={room.paint} data-room-section={room.id} aria-labelledby={headingId}>
  <div class="wrap">
    <header class="room__wall">
      <h2 class="room__name" id={headingId}>
        <Mark name={room.mark} class="room__mark" />
        <span class="room__number tabular"><span class="visually-hidden">Room </span>{room.number}</span>
        <span class="visually-hidden">: </span>
        <span class="room__org">{room.org}</span>
      </h2>
      <div class="room__text">
        {
          room.role ? (
            <p class="room__role">
              {room.role}
              <span class="room__range">
                {room.startLabel} {room.start.label}
                {room.end ? (
                  `, left ${room.end.label}`
                ) : (
                  <>
                    {" · "}
                    <span class="tabular" data-since={room.start.time}>
                      Day {dayCount(room.start.time, Date.now()).toLocaleString("en-US")}
                    </span>
                  </>
                )}
              </span>
            </p>
          ) : (
            <p class="room__role">
              {room.works.length === 1 ? "One work" : `${room.works.length} works`}
              <span class="room__range">{roomRange(room)}</span>
            </p>
          )
        }
        {room.summary && <p class="room__summary">{room.summary}</p>}
        {
          room.link && (
            <a class="room__link" href={room.link.href} rel="noopener">
              {room.link.label}
              <Icon name="external" />
            </a>
          )
        }
      </div>
    </header>

    <ul class="room__works" role="list" aria-label={`Works in ${room.org}`}>
      {room.works.map((work) => <Work work={work} room={room} />)}
    </ul>
  </div>
</section>

<style>
  .room {
    padding-block: var(--space-9) calc(var(--space-9) + var(--space-4));
    scroll-margin-top: var(--masthead);
    transition: background-color var(--slow) var(--ease);
  }

  /* House lights down: the whole room darkens around the one lit work. */
  .room[data-lit] {
    background: color-mix(in oklch, var(--paint) 72%, oklch(8% 0.01 60));
  }

  .room__wall {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-6) var(--space-8);
    align-items: end;
    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--vinyl-rule);
  }

  /* The room sign: its number set light beside the name, as on a gallery wall. */
  .room__name {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-5);
    align-items: baseline;
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .room__number {
    font-weight: 200;
    color: var(--vinyl-quiet);
  }

  /* The org's mark, lettered in vinyl above the name it belongs to. */
  .room__name :global(.room__mark) {
    grid-column: 2;
    height: 1.6em;
    margin-bottom: var(--space-4);
  }

  .room__name :global(.mark--wordmark.room__mark) {
    height: 1.1em;
  }

  .room__text {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }

  .room__role {
    display: grid;
    gap: var(--space-1);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.3;
  }

  .room__range {
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--vinyl-soft);
  }

  .room__summary {
    color: var(--vinyl-soft);
  }

  .room__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    justify-self: start;
    font-weight: 650;
  }

  .room__link :global(.icon) {
    width: 1em;
    height: 1em;
  }

  /* One hang line: frames in a row center on the same eye level. */
  .room__works {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17.5rem), 1fr));
    grid-auto-rows: auto;
    gap: var(--space-8) var(--space-7);
    margin-top: var(--space-8);
  }

  /* A room with one or two works hangs them beside its wall text. */
  @media (min-width: 52.01rem) {
    .room--compact .wrap {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-8);
      align-items: start;
    }

    .room--compact .room__wall {
      grid-template-columns: 1fr;
      align-items: start;
      padding-bottom: 0;
      border-bottom: 0;
    }

    .room--compact .room__works {
      margin-top: 0;
    }
  }

  @media (max-width: 52rem) {
    .room {
      padding-block: var(--space-8);
    }

    .room__wall {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .room__works {
      gap: var(--space-7) var(--space-6);
      margin-top: var(--space-7);
    }
  }
</style>
