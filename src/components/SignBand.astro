---
import portrait from "../assets/portrait.jpg";
import type { Line, Profile } from "../lib/network";
import Icon from "./Icon.astro";

interface Props {
  profile: Profile;
  lines: Line[];
}

const { profile, lines } = Astro.props;
const current = lines.filter((l) => !l.end);
const firstName = profile.name.split(" ")[0];
---

<header class="sign on-sign">
  <div class="sign__inner wrap">
    <img
      class="sign__portrait"
      src={portrait.src}
      alt={`Portrait of ${profile.name}`}
      width={portrait.width}
      height={portrait.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="sign__id">
      <h1 class="sign__name">{profile.name}</h1>
      <p class="sign__headline">{profile.headline}</p>
      <div class="sign__served">
        <ul class="sign__lines" role="list" aria-label="Lines serving this station">
          {
            current.map((line) => (
              <li>
                <a
                  class="bullet"
                  data-color={line.color}
                  href={`#line-${line.id}`}
                  aria-label={`${line.org} line: ${line.title}`}
                >
                  {line.code}
                </a>
              </li>
            ))
          }
        </ul>
        <span class="sign__location">{profile.location}</span>
      </div>
    </div>
    <nav class="sign__actions" aria-label="Contact and links">
      <a class="info-sign" href={`mailto:${profile.email}`} data-punch="say-hello">
        <Icon name="mail" />
        Email {firstName}
      </a>
      <ul class="sign__links" role="list">
        <li><a href="/resume">Resume</a></li>
        <li><a href={profile.links.github} rel="me">GitHub</a></li>
        <li><a href={profile.links.linkedin} rel="me">LinkedIn</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .sign {
    position: relative;
    background: var(--sign);
    color: var(--sign-ink);
  }

  /* The thin white rule that runs along the top of a station sign. */
  .sign::before {
    content: "";
    position: absolute;
    inset: 0.5rem 0 auto;
    height: 2px;
    background: var(--sign-ink);
  }

  .sign__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4) var(--space-7);
    padding-block: var(--space-6) var(--space-5);
  }

  .sign__portrait {
    width: clamp(6.5rem, 4rem + 5vw, 8.75rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--sign-ink);
  }

  .sign__name {
    font-size: var(--step-4);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .sign__headline {
    margin-top: var(--space-3);
    max-width: 40ch;
    color: var(--sign-ink-soft);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.35;
  }

  .sign__served {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .sign__lines {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sign__lines .bullet {
    transition: transform 160ms var(--ease-out);
  }

  .sign__lines .bullet:hover {
    transform: scale(1.08);
  }

  .sign__location {
    color: var(--sign-ink-soft);
    font-weight: 600;
  }

  .sign__actions {
    display: grid;
    justify-items: end;
    gap: var(--space-4);
  }

  .sign__links {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
  }

  .sign__links a {
    color: var(--sign-ink);
    text-decoration-color: color-mix(in oklch, var(--sign-ink) 45%, transparent);
  }

  .sign__links a:hover {
    text-decoration-color: var(--sign-ink);
  }

  @media (max-width: 60rem) {
    .sign__inner {
      grid-template-columns: auto minmax(0, 1fr);
      padding-block: var(--space-6) var(--space-5);
    }

    .sign__actions {
      grid-column: 1 / -1;
      justify-items: start;
      grid-template-columns: auto 1fr;
      align-items: center;
    }
  }

  @media (max-width: 36rem) {
    .sign__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }

    .sign__portrait {
      width: 5.5rem;
    }

    .sign__actions {
      grid-template-columns: minmax(0, 1fr);
      justify-items: stretch;
    }

    .sign__actions .info-sign {
      justify-content: center;
    }
  }
</style>
