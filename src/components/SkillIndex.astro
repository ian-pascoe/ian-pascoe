---
import { allStations, type Station, type Timeline } from "../lib/network";

interface Props {
  timeline: Timeline;
}

const { timeline } = Astro.props;
const lineById = new Map(timeline.lines.map((l) => [l.id, l]));
const bySkill = new Map<string, Station[]>();
for (const station of allStations(timeline)) {
  for (const skill of station.skills) {
    bySkill.set(skill, [...(bySkill.get(skill) ?? []), station]);
  }
}
const entries = [...bySkill.entries()].sort(([a], [b]) => a.localeCompare(b, "en", { sensitivity: "base" }));
---

{
  entries.length > 0 && (
    <section class="index wrap" aria-labelledby="index-title">
      <header class="index__head">
        <h2 id="index-title">Index of skills</h2>
        <p>Each skill, and the stops that prove it.</p>
      </header>
      <dl class="index__list">
        {entries.map(([skill, proofs]) => (
          <div class="index__entry">
            <dt>{skill}</dt>
            <dd>
              <ul role="list">
                {proofs.map((stop) => {
                  const line = stop.lineId ? lineById.get(stop.lineId) : undefined;
                  return (
                    <li>
                      {line && (
                        <span class="bullet" data-color={line.color} aria-hidden="true">
                          {line.code}
                        </span>
                      )}
                      <a href={`#stop-${stop.id}`}>{stop.name}</a>
                    </li>
                  );
                })}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

<style>
  .index {
    padding-top: var(--space-8);
    padding-bottom: var(--space-9);
  }

  .index__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 4px solid var(--ink);
  }

  .index__head h2 {
    font-size: var(--step-3);
    font-weight: 800;
  }

  .index__head p {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .index__list {
    columns: 3 18rem;
    column-gap: var(--space-7);
    margin-top: var(--space-5);
  }

  .index__entry {
    display: grid;
    grid-template-columns: auto minmax(1.5rem, 1fr) auto;
    align-items: baseline;
    gap: var(--space-2);
    padding-block: var(--space-2);
    break-inside: avoid;
  }

  /* Dotted leader between the skill and its stops, as in a map's street index. */
  .index__entry::after {
    content: "";
    grid-column: 2;
    grid-row: 1;
    align-self: start;
    height: calc(1lh - 0.4em);
    border-bottom: 2px dotted var(--ink-quiet);
  }

  .index__entry dt {
    grid-column: 1;
    font-weight: 800;
  }

  .index__entry dd {
    grid-column: 3;
    grid-row: 1;
  }

  .index__entry ul {
    display: grid;
    justify-items: end;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index__entry li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
  }

  .index__entry .bullet {
    --size: 1.35rem;
  }
</style>
