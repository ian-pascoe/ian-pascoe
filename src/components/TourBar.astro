---
import Icon from "./Icon.astro";
---

<div class="tour" data-tour data-paint="ink" role="region" aria-label="Guided tour" hidden>
  <div class="tour__now">
    <p class="tour__step tabular" data-tour-step></p>
    <p class="tour__title" data-tour-title aria-live="polite"></p>
  </div>
  <div class="tour__controls">
    <button type="button" class="tour__button" data-tour-prev>
      <Icon name="left" />
      <span>Previous</span>
    </button>
    <button type="button" class="tour__button tour__button--next" data-tour-next>
      <span data-tour-next-label>Next</span>
      <Icon name="right" />
    </button>
    <button type="button" class="tour__button tour__button--end" data-tour-end aria-label="End the tour">
      <Icon name="close" />
    </button>
  </div>
</div>

<style>
  .tour {
    position: fixed;
    left: 50%;
    bottom: var(--space-4);
    z-index: 30;
    display: flex;
    align-items: center;
    gap: var(--space-5);
    width: min(calc(100% - 2 * var(--space-4)), 44rem);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-5);
    box-shadow: var(--float);
    transform: translateX(-50%);
    animation: tour-in var(--slow) var(--ease);
  }

  .tour[hidden] {
    display: none;
  }

  @keyframes tour-in {
    from {
      opacity: 0;
      transform: translate(-50%, 1rem);
    }
  }

  .tour__now {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .tour__step {
    font-size: var(--step--1);
    color: var(--vinyl-quiet);
  }

  .tour__title {
    overflow: hidden;
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .tour__title cite {
    font-style: italic;
  }

  .tour__controls {
    display: flex;
    gap: var(--space-2);
  }

  .tour__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1.5px solid var(--vinyl-rule);
    background: transparent;
    font-size: var(--step--1);
    font-weight: 700;
    cursor: pointer;
    transition: background-color var(--fast) var(--ease);
  }

  .tour__button:hover {
    background: oklch(100% 0 0 / 0.08);
  }

  .tour__button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .tour__button--next {
    border-color: var(--vinyl);
    background: var(--vinyl);
    color: var(--paint);
  }

  .tour__button--next:hover {
    background: var(--vinyl-soft);
  }

  .tour__button--end {
    padding: 0;
    width: 2.75rem;
    justify-content: center;
  }

  .tour__button :global(.icon) {
    width: 1.1em;
    height: 1.1em;
  }

  /* Phones: one row. The step names stay; the buttons keep their names for screen readers but show only arrows. */
  @media (max-width: 36rem) {
    .tour {
      gap: var(--space-3);
      padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    }

    .tour__controls {
      gap: var(--space-1);
    }

    .tour__button {
      width: 2.75rem;
      padding: 0;
      justify-content: center;
    }

    .tour__button span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
