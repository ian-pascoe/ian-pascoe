---
import type { Profile } from "../lib/exhibition";
import { ICONS, type IconName } from "../lib/icons";
import { STAMPS, type StampId } from "../lib/passport";
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";

interface Props {
  profile: Profile;
  year: number;
}

const { profile, year } = Astro.props;
const firstName = profile.name.split(" ")[0];
// Each stamp's emblem pictures what earns it.
const EMBLEMS: Record<StampId, IconName> = {
  "first-look": "look",
  "two-rooms": "rooms",
  "every-wall": "frame",
  "full-tour": "light",
  checklist: "checklist",
  backstage: "installing",
  "say-hello": "mail",
};
---

<footer class="desk" id="desk" data-room-section="desk" aria-labelledby="desk-heading">
  <div class="desk__inner wrap">
    <div class="desk__contact">
      <h2 id="desk-heading" class="desk__heading">Questions about the work? Ask {firstName}.</h2>
      <a class="desk__address" href={`mailto:${profile.email}`} data-stamp="say-hello">{profile.email}</a>
      <div class="desk__actions">
        <a class="button desk__email" href={`mailto:${profile.email}`} data-stamp="say-hello">
          <Icon name="mail" />
          Email {firstName}
        </a>
        <a class="button button--quiet" href="/resume">Checklist of works</a>
      </div>
      <ul class="desk__links" role="list">
        <li>
          <a href={profile.links.github} rel="noopener"><Mark name="github" />GitHub</a>
        </li>
        <li>
          <a href={profile.links.linkedin} rel="noopener"><Mark name="linkedin" />LinkedIn</a>
        </li>
        <li>{profile.location}</li>
      </ul>
    </div>

    <section class="passport" id="passport" aria-labelledby="passport-heading">
      <header class="passport__head">
        <h3 id="passport-heading">Your gallery passport</h3>
        <p class="passport__count tabular" data-passport-count aria-live="polite">
          0 of {STAMPS.length} stamps
        </p>
      </header>
      <p class="passport__note">
        Stamps for looking around. They live only in this browser, and nothing on the site is locked behind them.
      </p>
      <ol class="passport__stamps" role="list">
        {
          STAMPS.map((s, i) => (
            <li class="stamp" data-stamp-slot={s.id} style={`--tilt: ${((i * 37) % 17) - 8}deg`}>
              <svg class="stamp__mark" viewBox="0 0 100 100" aria-hidden="true">
                <defs>
                  <path id={`stamp-ring-${s.id}`} d="M50 50m-35 0a35 35 0 1 1 70 0a35 35 0 1 1 -70 0" />
                </defs>
                <circle class="stamp__outer" cx="50" cy="50" r="46" />
                <circle class="stamp__inner" cx="50" cy="50" r="27" />
                <path class="stamp__emblem" d={ICONS[EMBLEMS[s.id]]} transform="translate(38 28)" />
                <text class="stamp__ring">
                  <textPath href={`#stamp-ring-${s.id}`} textLength="218" lengthAdjust="spacing">
                    {`${s.name.toUpperCase()} · ${s.name.toUpperCase()} · `}
                  </textPath>
                </text>
                <text class="stamp__date" x="50" y="67" text-anchor="middle" data-stamp-date />
              </svg>
              <p class="stamp__name">{s.name}</p>
              <p class="stamp__how" data-stamp-how>{s.how}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
  <p class="desk__colophon wrap">
    © {year} {profile.name}. Every figure comes from his own record; nothing is invented.
  </p>
</footer>

<style>
  .desk {
    padding-block: var(--space-9) var(--space-6);
    border-top: 2px solid var(--ink);
    scroll-margin-top: var(--masthead);
  }

  .desk__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-8);
    align-items: start;
  }

  .desk__contact {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .desk__heading {
    font-size: var(--step-3);
    font-weight: 750;
    letter-spacing: -0.025em;
  }

  .desk__address {
    font-size: clamp(1.5rem, 0.9rem + 2.4vw, 2.75rem);
    font-weight: 300;
    font-style: italic;
    letter-spacing: -0.02em;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .desk__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .desk__email {
    min-height: 3.5rem;
    padding-inline: var(--space-6);
    font-size: var(--step-1);
  }

  .desk__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-weight: 600;
    color: var(--vinyl-soft);
  }

  .desk__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .desk__links :global(.mark) {
    height: 1.15em;
  }

  .passport {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--vinyl-rule);
  }

  .passport__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
  }

  .passport__head h3 {
    font-size: var(--step-1);
    font-weight: 700;
  }

  .passport__count {
    font-weight: 600;
    color: var(--vinyl-soft);
  }

  .passport__note {
    max-width: 48ch;
    font-size: var(--step--1);
    color: var(--vinyl-quiet);
  }

  .passport__stamps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: var(--space-5) var(--space-4);
    margin-top: var(--space-3);
  }

  .stamp {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .stamp__mark {
    width: 5.25rem;
    height: 5.25rem;
    margin-bottom: var(--space-2);
    color: var(--vinyl-quiet);
    transition:
      transform var(--slow) var(--ease),
      color var(--slow) var(--ease);
  }

  .stamp__outer,
  .stamp__inner {
    fill: none;
    stroke: currentColor;
  }

  .stamp__outer {
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
    opacity: 0.7;
  }

  .stamp__inner {
    stroke-width: 1;
    stroke-dasharray: 2 4;
    opacity: 0.45;
  }

  .stamp__emblem {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: square;
    stroke-linejoin: miter;
    opacity: 0.7;
  }

  .stamp.is-stamped .stamp__emblem {
    stroke-width: 2.25;
    opacity: 1;
  }

  .stamp.is-stamped :is(.stamp__outer, .stamp__inner) {
    opacity: 1;
  }

  .stamp__ring,
  .stamp__date {
    font-family: var(--font);
    fill: currentColor;
    opacity: 0;
  }

  .stamp__ring {
    font-size: 9px;
    font-weight: 750;
  }

  .stamp__date {
    font-size: 10px;
    font-weight: 800;
  }

  .stamp__name {
    font-weight: 700;
    line-height: 1.25;
  }

  .stamp__how {
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--vinyl-quiet);
  }

  /* Stamped: solid red ink, pressed at an angle. State is the mark, not a color swap. */
  .stamp.is-stamped .stamp__mark {
    color: var(--stamp-ink);
    transform: rotate(var(--tilt));
  }

  .stamp.is-stamped .stamp__outer {
    stroke-width: 3.5;
    stroke-dasharray: none;
  }

  .stamp.is-stamped .stamp__inner {
    stroke-width: 1.5;
    stroke-dasharray: none;
  }

  .stamp.is-stamped :is(.stamp__ring, .stamp__date) {
    opacity: 1;
  }

  .stamp.just-stamped .stamp__mark {
    animation: press var(--slow) var(--ease);
  }

  @keyframes press {
    from {
      transform: rotate(var(--tilt)) scale(1.35);
      opacity: 0;
    }
  }

  .desk__colophon {
    margin-top: var(--space-9);
    padding-top: var(--space-5);
    border-top: 1px solid var(--vinyl-rule);
    font-size: var(--step--1);
    color: var(--vinyl-quiet);
  }

  @media (max-width: 56rem) {
    .desk__inner {
      grid-template-columns: 1fr;
    }

    .passport {
      padding: var(--space-5);
    }
  }
</style>
