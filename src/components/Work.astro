---
import { STATUSES, type Room, type Work } from "../lib/exhibition";
import { skillMark } from "../lib/marks";
import Drawing from "./Drawing.astro";
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";

interface Props {
  work: Work;
  room: Room;
}

const { work, room } = Astro.props;
const drawingId = `${work.id}-drawing`;
const onGitHub = work.link ? new URL(work.link.href).hostname === "github.com" : false;
---

<li
  class:list={["work", `work--${work.drawing.kind}`, { "work--featured": work.featured }]}
  id={work.id}
  data-work={work.id}
  data-room={room.id}
  data-title={work.title}
  data-when={work.date?.label ?? ""}
>
  <button type="button" class="work__frame" aria-pressed="false" aria-label={`Light ${work.title}`} aria-describedby={drawingId} data-light={work.id}>
    <span class="work__mat">
      <Drawing drawing={work.drawing} date={work.date} id={drawingId} fact={work.metric && `${work.metric} ${work.metricLabel}`} />
    </span>
  </button>
  <div class="work__label">
    {
      work.metric && (
        <p class="work__figure">
          <span class="work__metric tabular">{work.metric.replace("-", "−")}</span>
          <span class="work__measure">{work.metricLabel}</span>
        </p>
      )
    }
    <div class="work__text">
      <h3 class="work__title">
        <cite>{work.title}</cite>{work.date && <>, <time datetime={work.date.iso}>{work.date.label}</time></>}
      </h3>
      {work.detail && <p class="work__detail">{work.detail}</p>}
      {work.status && <p class="work__status">{STATUSES[work.status]}</p>}
      {
        work.skills.length > 0 && (
          <ul class="work__medium" role="list" aria-label="Medium">
            {work.skills.map((skill) => (
              <li>
                <Mark name={skillMark(skill)} />
                {skill}
              </li>
            ))}
          </ul>
        )
      }
      <p class="work__foot">No. <span class="tabular">{work.number}</span></p>
      {
        work.link && (
          <a class="work__link" href={work.link.href} rel="noopener">
            <Mark name={onGitHub ? "github" : undefined} />
            {work.link.label}
            <Icon name="external" />
          </a>
        )
      }
    </div>
  </div>
</li>

<style>
  /* Three shared rows per hang: frames on one eye line, figures on one line, titles on one line.
     The room's grid has no row gap (it would open up empty figure rows), so each hang keeps its own space below. */
  .work {
    position: relative;
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
    margin-bottom: var(--hang-gap, var(--space-8));
  }

  /* The light pool a lit work stands in. */
  .work::before {
    content: "";
    position: absolute;
    inset: -3rem -2.5rem -1rem;
    z-index: 0;
    background: radial-gradient(closest-side, color-mix(in oklch, var(--light) 44%, transparent), transparent);
    opacity: 0.28;
    pointer-events: none;
    transition: opacity var(--slow) var(--ease);
  }

  .work__frame {
    position: relative;
    z-index: 1;
    align-self: center;
    justify-self: start;
    display: block;
    width: min(100%, var(--frame, 15rem));
    margin-bottom: var(--space-5);
    padding: 0;
    border: 0.3rem solid var(--moulding);
    background: var(--mat);
    box-shadow: var(--hung);
    cursor: pointer;
    transition:
      transform var(--slow) var(--ease),
      box-shadow var(--slow) var(--ease),
      filter var(--slow) var(--ease);
  }

  .work__frame:hover {
    transform: translateY(-2px);
  }

  .work__frame:focus-visible {
    outline-offset: 6px;
  }

  .work__mat {
    display: block;
    padding: 14%;
  }

  .work--count .work__mat,
  .work--text .work__mat {
    padding: 12% 11%;
  }

  .work--reduction {
    --frame: 14rem;
  }

  .work--increase {
    --frame: 12.5rem;
  }

  .work--count {
    --frame: 16rem;
  }

  .work--document {
    --frame: 12rem;
  }

  .work--text {
    --frame: 16rem;
  }

  .work--featured {
    --frame: 18.5rem;
  }

  .work--featured.work--increase {
    --frame: 16rem;
  }

  .work__label {
    position: relative;
    z-index: 1;
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    max-width: 24rem;
  }

  .work__figure {
    grid-row: 1;
    align-self: end;
    display: grid;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .work__text {
    grid-row: 2;
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .work__metric {
    font-size: var(--step-3);
    font-weight: 750;
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .work__measure {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.3;
  }

  .work__title {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .work__title cite {
    font-style: italic;
  }

  .work__title time {
    font-weight: 400;
  }

  .work__detail {
    color: var(--vinyl-soft);
    line-height: 1.5;
  }

  .work__status {
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .work__medium,
  .work__foot {
    font-size: var(--step--1);
    color: var(--vinyl-quiet);
  }

  .work__medium {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-weight: 600;
    color: var(--vinyl-soft);
  }

  .work__medium li {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .work__medium :global(.mark) {
    height: 1.25em;
  }

  .work__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    justify-self: start;
    font-size: var(--step--1);
    font-weight: 650;
  }

  .work__link :global(.icon),
  .work__link :global(.mark) {
    width: 1em;
    height: 1em;
  }

  /* Lit and dimmed: the only state change in the rooms is light. */
  .work.is-lit::before,
  :global(html:not(.js)) .work:target::before {
    opacity: 1;
  }

  .work.is-lit .work__frame {
    transform: translateY(-3px) scale(1.015);
    box-shadow:
      0 1px 1px oklch(0% 0 0 / 0.2),
      0 22px 40px -12px oklch(0% 0 0 / 0.5);
  }

  :global([data-lit]) .work:not(.is-lit)::before {
    opacity: 0;
  }

  /* The other works fall into shadow: their frames dim and lose their hung shadow, and their labels drop
     to the quiet lettering, which each paint keeps readable when lit. */
  :global([data-lit]) .work:not(.is-lit) .work__frame {
    box-shadow: 0 1px 1px oklch(0% 0 0 / 0.3);
    filter: brightness(0.8);
  }

  :global([data-lit]) .work:not(.is-lit) :is(.work__label, .work__detail, .work__medium) {
    color: var(--vinyl-quiet);
  }

  /* Phones: each work hangs beside its label, so a room reads as a list. */
  @media (max-width: 40rem) {
    .work {
      grid-row: auto;
      grid-template-rows: none;
      grid-template-columns: 7.25rem minmax(0, 1fr);
      column-gap: var(--space-5);
      align-items: start;
    }

    .work__frame {
      align-self: start;
      width: 100%;
      margin-bottom: 0;
      border-width: 0.2rem;
    }

    .work::before {
      inset: -1.5rem -1rem;
    }

    .work__label {
      grid-row: auto;
      grid-template-rows: none;
    }

    .work__figure,
    .work__text {
      grid-row: auto;
    }

    .work__metric {
      font-size: var(--step-2);
    }

    /* A thumb-sized hit area without moving the lettering. */
    .work__link {
      padding-block: 0.7rem;
      margin-block: -0.7rem;
    }
  }

  @media (forced-colors: active) {
    .work.is-lit .work__frame {
      outline: 3px solid Highlight;
      outline-offset: 6px;
    }
  }
</style>
