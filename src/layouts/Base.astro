---
import "@fontsource-variable/saira/wdth.css";
import "../styles/global.css";
import type { ObservationId } from "../lib/observations";

interface Props {
  title: string;
  description: string;
  pageObservation?: ObservationId;
  bodyClass?: string;
}

const { title, description, pageObservation, bodyClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#020203" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {
      beaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beaconToken })}
        />
      )
    }
  </head>
  <body data-page-observation={pageObservation} class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import { OBSERVATIONS, OBSERVED_EVENT, readLog, wireObservations, type ObservationId } from "../lib/observations";

      const renderLog = (fresh?: ObservationId) => {
        const log = readLog();
        for (const slot of document.querySelectorAll<HTMLElement>("[data-obs-slot]")) {
          const id = slot.dataset.obsSlot as ObservationId;
          const at = log[id];
          slot.classList.toggle("is-logged", Boolean(at));
          slot.classList.toggle("just-logged", id === fresh);
          const when = slot.querySelector("[data-obs-when]");
          if (at && when) {
            const day = new Date(at).toLocaleDateString("en-US", { day: "numeric", month: "short" });
            when.textContent = `Logged ${day}`;
          }
        }
        const total = Object.keys(log).length;
        const count = document.querySelector("[data-log-count]");
        if (count) count.textContent = `${total} of ${OBSERVATIONS.length} logged`;
        const tally = document.querySelector("[data-log-tally]");
        if (tally) tally.textContent = String(total);
        document.querySelector("[data-log-indicator]")?.classList.toggle("has-logged", total > 0);
      };

      const flash = document.querySelector<HTMLElement>("[data-log-flash]");
      const status = document.querySelector<HTMLElement>("[data-log-status]");
      let flashTimer = 0;
      window.addEventListener(OBSERVED_EVENT, (event) => {
        const id = (event as CustomEvent<{ id: ObservationId }>).detail.id;
        renderLog(id);
        const name = OBSERVATIONS.find((o) => o.id === id)?.name;
        if (!flash || !status || !name) return;
        const total = Object.keys(readLog()).length;
        flash.textContent = `Observed: ${name}`;
        status.textContent = `Observed: ${name}. ${total} of ${OBSERVATIONS.length} logged.`;
        flash.classList.add("is-shown");
        window.clearTimeout(flashTimer);
        flashTimer = window.setTimeout(() => {
          flash.classList.remove("is-shown");
          status.textContent = "";
        }, 3800);
      });

      renderLog();
      wireObservations();

      // Copy the address, for visitors whose mail link opens nothing.
      document.addEventListener("click", async (event) => {
        const button = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-copy]");
        const label = button?.querySelector("[data-copy-label]");
        if (!button || !label) return;
        const idle = label.textContent;
        try {
          await navigator.clipboard.writeText(button.dataset.copy!);
          label.textContent = "Copied";
        } catch {
          label.textContent = "Select and copy";
        }
        if (status) status.textContent = label.textContent === "Copied" ? "Address copied." : "";
        window.setTimeout(() => (label.textContent = idle), 2400);
      });
    </script>
  </body>
</html>
