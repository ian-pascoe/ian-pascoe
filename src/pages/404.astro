---
import Base from "../layouts/Base.astro";
import { loadTimeline } from "../lib/timeline";

const { profile } = loadTimeline();
---

<Base title={`Station closed · ${profile.name}`} description="This page is not on the map." pagePunch="off-the-map">
  <main id="main" class="closed">
    <header class="closed__sign on-sign">
      <div class="wrap closed__sign-inner">
        <p class="closed__code data">404</p>
        <h1>Station closed</h1>
      </div>
    </header>
    <div class="wrap closed__body">
      <p class="closed__lede">There's no stop at this address. It may have moved, or it was never on the map.</p>
      <p class="closed__punch">You found a station that isn't on the map, so your ride pass got a punch for it.</p>
      <div class="closed__actions">
        <a class="closed__home" href="/">Back to the network map</a>
        <a href={`mailto:${profile.email}`} data-punch="say-hello">Email {profile.name.split(" ")[0]}</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .closed__sign {
    position: relative;
    background: var(--sign);
    color: var(--sign-ink);
  }

  .closed__sign::before {
    content: "";
    position: absolute;
    inset: 0.5rem 0 auto;
    height: 2px;
    background: var(--sign-ink);
  }

  .closed__sign-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-8) var(--space-6);
  }

  .closed__code {
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    background: var(--sign-ink);
    color: var(--sign);
    font-size: 1.6rem;
    font-weight: 700;
  }

  .closed__sign h1 {
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .closed__body {
    padding-block: var(--space-7) var(--space-9);
  }

  .closed__lede {
    max-width: 38ch;
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.3;
  }

  .closed__punch {
    margin-top: var(--space-4);
    max-width: 60ch;
    color: var(--ink-soft);
  }

  .closed__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-6);
    font-weight: 700;
  }

  .closed__home {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.7rem 1.25rem 0.6rem;
    border-radius: 0.25rem;
    background: var(--sign);
    color: var(--sign-ink);
    text-decoration: none;
  }
</style>
