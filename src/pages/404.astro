---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { loadTimeline } from "../lib/timeline";

const { profile } = loadTimeline();
const firstName = profile.name.split(" ")[0];
---

<Base
  title={`Lost past the horizon · ${profile.name}`}
  description="Nothing orbits at this address."
  pageObservation="lost-signal"
>
  <main id="main" class="lost wrap">
    <svg class="lost__hole" viewBox="0 0 240 240" aria-hidden="true">
      <circle class="lost__orbit" cx="120" cy="120" r="104" />
      <circle class="lost__orbit" cx="120" cy="120" r="78" />
      <circle class="lost__shadow" cx="120" cy="120" r="46" />
      <path class="lost__ring" d="M74 120a46 46 0 0 1 92 0" />
      <circle class="lost__fragment" cx="198" cy="120" r="3" />
    </svg>
    <div class="lost__text">
      <h1 class="lost__title caps">Lost past the horizon</h1>
      <p class="lost__detail">
        Nothing orbits at this address (error 404). It may have moved, or it was never part of the record.
      </p>
      <p class="lost__note">You found the missing page, so it's logged in your observations.</p>
      <div class="lost__actions">
        <a class="button button--primary" href="/"><Icon name="orbit" />Back to the site</a>
        <a class="button" href={`mailto:${profile.email}`} data-observe="say-hello">Email {firstName}</a>
        <a class="button" href="/resume">Read the resume</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .lost {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-8);
    align-items: center;
    min-height: 100svh;
    padding-block: var(--space-8);
  }

  .lost__hole {
    justify-self: center;
    width: min(100%, 20rem);
    fill: none;
  }

  .lost__orbit {
    stroke: var(--rule-strong);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }

  .lost__shadow {
    fill: var(--void-deep);
    stroke: var(--rule-strong);
    stroke-width: 1;
  }

  .lost__ring {
    stroke: var(--gold);
    stroke-width: 1.5;
  }

  .lost__fragment {
    fill: var(--ember);
  }

  .lost__text {
    display: grid;
    gap: var(--space-4);
    max-width: 34rem;
  }

  .lost__title {
    font-size: var(--step-4);
    font-weight: 200;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .lost__detail {
    font-size: var(--step-1);
    color: var(--bone-soft);
  }

  .lost__note {
    color: var(--bone-quiet);
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  @media (max-width: 52rem) {
    .lost {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      align-content: center;
    }

    .lost__hole {
      width: min(60%, 14rem);
    }
  }
</style>
