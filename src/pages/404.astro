---
import Base from "../layouts/Base.astro";
import { loadTimeline } from "../lib/timeline";

const { profile } = loadTimeline();
const firstName = profile.name.split(" ")[0];
---

<Base
  title={`Closed for installation · ${profile.name}`}
  description="This room is closed for installation."
  pageStamp="backstage"
>
  <main id="main" class="closed wrap">
    <figure class="closed__work">
      <svg class="closed__wire" viewBox="0 0 200 40" aria-hidden="true">
        <path d="M2 40 100 3l98 37" />
        <circle cx="100" cy="3" r="2.6" />
      </svg>
      <div class="closed__frame">
        <div class="closed__mat"></div>
      </div>
    </figure>
    <div class="closed__label">
      <h1>Gallery closed for installation</h1>
      <p class="closed__detail">
        Nothing hangs at this address (error 404). It may have moved, or it was never part of the exhibition.
      </p>
      <p class="closed__note">
        You found the room that's closed, so your gallery passport has a stamp for it.
      </p>
      <div class="closed__actions">
        <a class="button" href="/">Return to the exhibition</a>
        <a class="button button--quiet" href={`mailto:${profile.email}`} data-stamp="say-hello">Email {firstName}</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .closed {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-8);
    align-items: center;
    min-height: 100svh;
    padding-block: var(--space-8);
  }

  .closed__work {
    display: grid;
    justify-items: center;
  }

  /* The hanging wire, taut from one hook to the frame's corners. */
  .closed__wire {
    width: min(64%, 14rem);
    overflow: visible;
  }

  .closed__wire path {
    fill: none;
    stroke: var(--ink-quiet);
    stroke-width: 1.5;
  }

  .closed__wire circle {
    fill: var(--ink);
  }

  .closed__frame {
    width: min(100%, 22rem);
    border: 0.35rem solid var(--moulding);
    background: var(--mat);
    box-shadow: var(--hung);
  }

  .closed__mat {
    aspect-ratio: 4 / 5;
    margin: 12%;
    border: 1px dashed var(--rule);
  }

  .closed__label {
    display: grid;
    gap: var(--space-4);
    max-width: 34rem;
  }

  .closed__label h1 {
    font-size: var(--step-4);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .closed__detail {
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .closed__note {
    color: var(--ink-quiet);
  }

  .closed__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  @media (max-width: 52rem) {
    .closed {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      align-content: center;
    }

    .closed__frame {
      width: min(70%, 16rem);
    }
  }
</style>
