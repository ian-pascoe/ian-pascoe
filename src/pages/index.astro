---
import Masthead from "../components/Masthead.astro";
import MediaIndex from "../components/MediaIndex.astro";
import Room from "../components/Room.astro";
import TitleWall from "../components/TitleWall.astro";
import TourBar from "../components/TourBar.astro";
import VisitorDesk from "../components/VisitorDesk.astro";
import Base from "../layouts/Base.astro";
import { loadTimeline } from "../lib/timeline";

const exhibition = loadTimeline();
const { profile, rooms, tour, firstYear, lastYear } = exhibition;
---

<Base
  title={`${profile.name} · ${profile.headline}`}
  description={`${profile.name}: Selected Work, ${firstYear}–${lastYear}. ${profile.headline}; ${tour.length} works, each drawn exactly from its fact.`}
>
  <Masthead exhibition={exhibition} />
  <main id="main">
    <TitleWall exhibition={exhibition} />
    {rooms.map((room) => <Room room={room} />)}
    <MediaIndex exhibition={exhibition} />
  </main>
  <VisitorDesk profile={profile} year={new Date(exhibition.builtAt).getUTCFullYear()} />
  <TourBar />
  <script type="application/json" id="tour-order" set:html={JSON.stringify(tour.map((w) => w.id))} />
  <script>
    import "../scripts/gallery";
  </script>
</Base>
