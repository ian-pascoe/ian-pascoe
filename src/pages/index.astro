---
import Arrival from "../components/Arrival.astro";
import Band from "../components/Band.astro";
import Composition from "../components/Composition.astro";
import Controls from "../components/Controls.astro";
import Disk from "../components/Disk.astro";
import Horizon from "../components/Horizon.astro";
import Masthead from "../components/Masthead.astro";
import Observations from "../components/Observations.astro";
import Base from "../layouts/Base.astro";
import { buildFall } from "../lib/fall";
import { loadTimeline } from "../lib/timeline";

const exhibition = loadTimeline();
const fall = buildFall(exhibition);
const { profile, works, firstYear, lastYear } = exhibition;
---

<Base
  title={`${profile.name} · ${profile.headline}`}
  description={`${profile.name}, ${firstYear}–${lastYear}. ${profile.headline}. ${works.length} achievements, each a dated fact from his own record.`}
>
  <Disk fall={fall} />
  <Masthead profile={profile} fall={fall} />
  <main id="main">
    <Arrival exhibition={exhibition} fall={fall} />
    <div class="fall">
      <h2 class="visually-hidden">The record, {firstYear} to now</h2>
      {fall.bands.map((band) => <Band band={band} />)}
    </div>
    <Composition exhibition={exhibition} />
    <Observations />
  </main>
  <Horizon profile={profile} year={new Date(exhibition.builtAt).getUTCFullYear()} />
  <Controls />
  <script>
    import "../scripts/horizon";
  </script>
</Base>

<style>
  main,
  :global(.horizon) {
    position: relative;
    z-index: 1;
  }

  /* Phones: the page scrolls beneath the disk's window; the closing screen rises above it once the window opens. */
  @media (max-width: 52rem) {
    main {
      padding: var(--reserve-top) 0 0 var(--reserve-left);
    }

    :global(.horizon) {
      z-index: 3;
    }
  }
</style>
