---
import Icon from "../components/Icon.astro";
import Mark from "../components/Mark.astro";
import Base from "../layouts/Base.astro";
import { STATUSES, mediaIndex, roomRange, type Work } from "../lib/exhibition";
import { symbolMark } from "../lib/marks";
import { loadTimeline } from "../lib/timeline";

const exhibition = loadTimeline();
const { profile, rooms, firstYear, lastYear } = exhibition;
const skills = mediaIndex(exhibition).map((m) => m.skill);
// Certifications read as one line at the foot of the resume, not as entries in their roles.
const isCertification = (w: Work) => w.drawing.kind === "document" && w.drawing.tag === "certification";
const certifications = exhibition.works.filter(isCertification);
const sections = rooms
  .map((room) => ({ room, works: room.works.filter((w) => !isCertification(w)) }))
  .filter(({ room, works }) => room.role || works.length > 0);
const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "");
---

<Base
  title={`${profile.name} · Resume`}
  description={`Resume of ${profile.name}: ${profile.headline}.`}
  pageObservation="the-log"
  bodyClass="log-page"
>
  <div class="toolbar">
    <a class="toolbar__back" href="/">
      <Icon name="left" />
      Back to the site
    </a>
    <button type="button" class="button toolbar__print" data-print>
      <Icon name="print" />
      Print or save as PDF
    </button>
  </div>

  <main id="main" class="sheet">
    <header class="sheet__head">
      <h1>{profile.name}</h1>
      <p class="sheet__headline">{profile.headline}</p>
      <ul class="sheet__contact" role="list">
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a href={profile.links.linkedin}><Mark name="linkedin" />{bare(profile.links.linkedin)}</a></li>
        <li><a href={profile.links.github}><Mark name="github" />{bare(profile.links.github)}</a></li>
        <li><a href={profile.links.x}><Mark name="x" />{bare(profile.links.x)}</a></li>
        <li>{profile.location}</li>
      </ul>
      <p class="sheet__show">{firstYear}–{lastYear} · also at <a href="https://ianpascoe.dev/">ianpascoe.dev</a></p>
    </header>

    {
      sections.map(({ room, works }) => (
        <section class="room" aria-labelledby={`c-${room.id}`}>
          <header class="room__head">
            <h2 id={`c-${room.id}`}>
              <Mark name={symbolMark(room.mark)} />
              {room.role ? `${room.role}, ${room.org}` : room.org}
            </h2>
            <p class="room__when tabular">{roomRange(room)}</p>
          </header>
          {room.summary && <p class="room__summary">{room.summary}</p>}
          <ol class="works" role="list">
            {works.map((work) => (
              <li class="entry">
                <p class="entry__text">
                  {work.metric ? (
                    <strong>
                      {work.metric} {work.metricLabel}.
                    </strong>
                  ) : (
                    work.kind === "event" && <strong>{work.title}.</strong>
                  )}{" "}
                  {work.detail}
                  {work.kind === "achievement" && (
                    <span class="entry__title">
                      {" "}
                      <cite>{work.title}</cite>
                    </span>
                  )}
                  {work.kind === "achievement" && work.skills.length > 0 && (
                    <span class="entry__medium">{work.skills.join(" · ")}</span>
                  )}
                </p>
                {(work.date || work.status) && (
                  <span class="entry__when tabular">
                    {[work.date?.label, work.status && STATUSES[work.status]].filter(Boolean).join(" · ")}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    {
      skills.length > 0 && (
        <section class="room" aria-labelledby="c-skills">
          <header class="room__head">
            <h2 id="c-skills">Skills</h2>
          </header>
          <p class="skills">{skills.join(" · ")}</p>
        </section>
      )
    }

    {
      certifications.length > 0 && (
        <section class="room" aria-labelledby="c-certifications">
          <header class="room__head">
            <h2 id="c-certifications">Certifications</h2>
          </header>
          <p class="skills">
            {certifications.map((w, i) => (
              <>
                {i > 0 && " · "}
                {w.title} ({w.date!.year})
              </>
            ))}
          </p>
        </section>
      )
    }
  </main>
</Base>

<script>
  document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
</script>

<style is:global>
  .log-page {
    --ink: var(--bone);
    --ink-soft: var(--bone-soft);
    --ink-quiet: var(--bone-quiet);
    --line: var(--rule);
    --line-strong: var(--rule-strong);
    --accent: var(--gold);
  }

  @media print {
    .log-page {
      --ink: #111;
      --ink-soft: #333;
      --ink-quiet: #555;
      --line: #ccc;
      --line-strong: #111;
      --accent: #111;
      background: #fff !important;
      color: #111;
    }
  }
</style>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    max-width: 54rem;
    margin-inline: auto;
    padding: var(--space-5) var(--gutter);
  }

  .toolbar__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .toolbar :global(.icon) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .toolbar__print {
    min-height: 2.75rem;
  }

  .sheet {
    max-width: 54rem;
    margin: 0 auto var(--space-8);
    padding: var(--space-6) var(--gutter) 0;
    color: var(--ink);
    font-size: var(--step-0);
    line-height: 1.5;
  }

  .sheet__head {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line-strong);
  }

  .sheet__head h1 {
    font-size: var(--step-4);
    font-weight: 200;
    font-stretch: 125%;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  .sheet__headline {
    font-size: var(--step-1);
    font-weight: 400;
  }

  .sheet__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .sheet__contact a {
    color: var(--ink);
  }

  .sheet__contact :global(.mark) {
    height: 1.1em;
    margin-right: 0.35em;
    vertical-align: -0.2em;
  }

  .sheet__show {
    font-size: var(--step--1);
    color: var(--ink-quiet);
  }

  /* Sections may break across pages; single entries never do, and a heading never ends a page. */
  .room {
    margin-top: var(--space-7);
  }

  .room__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line-strong);
    break-after: avoid;
  }

  .room__head h2 {
    font-size: var(--step-1);
    font-weight: 500;
    font-stretch: 112%;
    letter-spacing: 0.02em;
  }

  .room__head :global(.mark) {
    height: 1.2em;
    margin-right: 0.4em;
    vertical-align: -0.22em;
  }

  .room__when {
    font-size: var(--step--1);
    color: var(--accent);
    white-space: nowrap;
  }

  .room__summary {
    max-width: 38em;
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  .works {
    margin-top: var(--space-2);
  }

  /* A row is the entry, then its date where a resume keeps dates: on the right. */
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-5);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    break-inside: avoid;
  }

  .entry__text {
    max-width: 38em;
  }

  .entry__text strong {
    font-weight: 550;
  }

  .entry__when {
    font-size: var(--step--1);
    color: var(--accent);
  }

  .entry__title {
    font-size: var(--step--1);
    color: var(--ink-quiet);
  }

  .entry__medium {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .skills {
    max-width: 38em;
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  /* Links keep a 44px target without adding space to the sheet. */
  .sheet__contact a {
    display: inline-block;
  }

  .sheet__contact a,
  .toolbar__back {
    padding-block: 0.7rem;
    margin-block: -0.7rem;
  }

  @media (max-width: 40rem) {
    .room__head {
      flex-direction: column;
      align-items: start;
      gap: var(--space-1);
    }
  }

  @page {
    size: letter;
    margin: 0.6in;
  }

  @media print {
    :global(.skip-link),
    .toolbar {
      display: none !important;
    }

    .sheet {
      max-width: none;
      margin: 0;
      padding: 0;
      font-size: 10pt;
    }

    .sheet__head h1 {
      font-size: 26pt;
    }

    .sheet a {
      text-decoration: none;
    }
  }
</style>
