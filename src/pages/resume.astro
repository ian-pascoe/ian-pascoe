---
import Icon from "../components/Icon.astro";
import Mark from "../components/Mark.astro";
import Base from "../layouts/Base.astro";
import { STATUSES, mediaIndex, roomRange, type Work } from "../lib/exhibition";
import { symbolMark } from "../lib/marks";
import { loadTimeline } from "../lib/timeline";

const exhibition = loadTimeline();
const { profile, rooms, firstYear, lastYear } = exhibition;
const skills = mediaIndex(exhibition).map((m) => m.skill);
// Certifications read as one line at the foot of the resume, not as works in their rooms.
const isCertification = (w: Work) => w.drawing.kind === "document" && w.drawing.tag === "certification";
const certifications = exhibition.tour.filter(isCertification);
const sections = rooms
  .map((room) => ({ room, works: room.works.filter((w) => !isCertification(w)) }))
  .filter(({ room, works }) => room.role || works.length > 0);
const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "");
---

<Base
  title={`${profile.name} · Resume`}
  description={`Resume of ${profile.name}, set as the checklist of works: ${profile.headline}.`}
  pageStamp="checklist"
  bodyClass="checklist-page"
>
  <div class="toolbar">
    <a class="toolbar__back" href="/">
      <Icon name="left" />
      Back to the exhibition
    </a>
    <button type="button" class="button toolbar__print" data-print>
      <Icon name="print" />
      Print or save as PDF
    </button>
  </div>

  <main id="main" class="sheet">
    <header class="sheet__head">
      <h1>{profile.name}</h1>
      <p class="sheet__headline">{profile.headline}</p>
      <ul class="sheet__contact" role="list">
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a href={profile.links.linkedin}><Mark name="linkedin" />{bare(profile.links.linkedin)}</a></li>
        <li><a href={profile.links.github}><Mark name="github" />{bare(profile.links.github)}</a></li>
        <li>{profile.location}</li>
      </ul>
      <p class="sheet__show">
        Resume, set as the checklist of works for <cite>Selected Work, {firstYear}–{lastYear}</cite>
      </p>
    </header>

    {
      sections.map(({ room, works }) => (
        <section class="room" aria-labelledby={`c-${room.id}`}>
          <header class="room__head">
            <h2 id={`c-${room.id}`}>
              <Mark name={symbolMark(room.mark)} />
              {room.role ? `${room.role}, ${room.org}` : room.org}
            </h2>
            <p class="room__when tabular">{roomRange(room)}</p>
          </header>
          {room.summary && <p class="room__summary">{room.summary}</p>}
          <ol class="works" role="list">
            {works.map((work) => (
              <li class="entry">
                <span class="entry__number tabular">{work.number}</span>
                <p class="entry__text">
                  {work.metric ? (
                    <strong>
                      {work.metric} {work.metricLabel}.
                    </strong>
                  ) : (
                    work.kind === "event" && <strong>{work.title}.</strong>
                  )}{" "}
                  {work.detail}
                  {work.kind === "achievement" && (
                    <span class="entry__title">
                      {" "}
                      <cite>{work.title}</cite>
                    </span>
                  )}
                </p>
                {(work.date || work.status) && (
                  <span class="entry__when tabular">
                    {[work.date?.label, work.status && STATUSES[work.status]].filter(Boolean).join(" · ")}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    {
      skills.length > 0 && (
        <section class="room" aria-labelledby="c-skills">
          <header class="room__head">
            <h2 id="c-skills">Skills</h2>
          </header>
          <p class="skills">{skills.join(" · ")}</p>
        </section>
      )
    }

    {
      certifications.length > 0 && (
        <section class="room" aria-labelledby="c-certifications">
          <header class="room__head">
            <h2 id="c-certifications">Certifications</h2>
          </header>
          <p class="skills">
            {certifications.map((w, i) => (
              <>
                {i > 0 && " · "}
                <span class="tabular">{w.number}</span> {w.title} ({w.date!.year})
              </>
            ))}
          </p>
        </section>
      )
    }
  </main>
</Base>

<script>
  document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
</script>

<style is:global>
  .checklist-page {
    background: var(--wall-sunk);
  }
</style>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    max-width: 54rem;
    margin-inline: auto;
    padding: var(--space-5) var(--gutter);
  }

  .toolbar__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: 650;
  }

  .toolbar :global(.icon) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .toolbar__print {
    min-height: 2.75rem;
    font-size: var(--step--1);
  }

  .sheet {
    max-width: 54rem;
    margin: 0 auto var(--space-8);
    padding: clamp(1.5rem, 1rem + 3vw, 4rem);
    background: var(--mat);
    box-shadow: var(--hung);
    font-size: 1rem;
    line-height: 1.45;
  }

  .sheet__head {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-5);
    border-bottom: 2px solid var(--ink);
  }

  .sheet__head h1 {
    font-size: var(--step-4);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .sheet__headline {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .sheet__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .sheet__contact a {
    color: var(--ink);
  }

  .sheet__contact :global(.mark) {
    height: 1.1em;
    margin-right: 0.35em;
    vertical-align: -0.2em;
  }

  .sheet__show {
    font-size: var(--step--1);
    color: var(--ink-quiet);
  }

  .room {
    margin-top: var(--space-6);
    break-inside: avoid-page;
  }

  .room__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--ink);
  }

  .room__head h2 {
    font-size: var(--step-1);
    font-weight: 750;
  }

  .room__head :global(.mark) {
    height: 1.2em;
    margin-right: 0.4em;
    vertical-align: -0.22em;
  }

  .room__when {
    font-size: var(--step--1);
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .room__summary {
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  .works {
    margin-top: var(--space-2);
  }

  .entry {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--rule);
    break-inside: avoid;
  }

  .entry__number,
  .entry__when {
    font-size: var(--step--1);
    color: var(--ink-quiet);
  }

  .entry__title {
    font-size: var(--step--1);
    color: var(--ink-quiet);
  }

  .skills {
    margin-top: var(--space-3);
  }

  @page {
    size: letter;
    margin: 0.6in;
  }

  @media print {
    :global(.skip-link),
    .toolbar {
      display: none !important;
    }

    :global(.checklist-page) {
      background: #fff;
    }

    .sheet {
      max-width: none;
      margin: 0;
      padding: 0;
      box-shadow: none;
      font-size: 10pt;
    }

    .sheet__head h1 {
      font-size: 28pt;
    }

    .sheet a {
      text-decoration: none;
    }
  }
</style>
